# ─── Database (MySQL 8) ───────────────────────────────────────
# mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://app_user:change-me@localhost:3306/ai_automation"

# ─── Auth.js ─────────────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET="replace-with-a-long-random-string"
# Public URL of the app (required behind a reverse proxy)
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# ─── Initial admin (used only by `npm run db:seed`) ──────────
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-at-least-12-chars"

# ─── Credential encryption (Phase 3, worker only) ────────────
# 32 random bytes, base64. Generate with: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=""

# ─── AI provider (Phase 5, server only) ──────────────────────
# Any OpenAI-compatible endpoint. Default: NVIDIA NIM.
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://integrate.api.nvidia.com/v1"
OPENAI_MODEL="nvidia/nemotron-3-ultra-550b-a55b"

# ─── Sync alerts (Phase 8, worker only) ──────────────────────
# Optional. JSON POST on failed / partial / sign-in-needed syncs (Slack, Teams, Google Chat…).
ALERT_WEBHOOK_URL=""

# ─── Document storage (Phase 9) ──────────────────────────────
# Private folder for candidate documents; worker writes, web reads. Never served directly.
FILES_DIR="./data/files"
# Optional ClamAV daemon host:port (e.g. clamav:3310). Empty = stored unscanned, flagged in the UI.
CLAMAV_HOST=""

# ─── Sync speed ──────────────────────────────────────────────
# Employees read at the same time during a full sync (1–4, default 3; each still paced by the source rate limit).
SYNC_PROFILE_CONCURRENCY=3
# Keep the computer from idle-sleeping while a sync runs (a sleeping PC pauses the sync). 0 = off.
SYNC_KEEP_AWAKE=1

# Maximum size of a downloaded candidate document, in MB (default 15)
DOCUMENT_MAX_MB="15"
